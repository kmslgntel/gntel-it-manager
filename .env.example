SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 새 DB (MariaDB) — 로컬 개발용
DB_ENGINE=django.db.backends.mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=it_manager
DB_USER=
DB_PASSWORD=

# 스위치 SSH (Juniper) — 사내망 접속 시 설정
SWITCH_USER=
SWITCH_PASSWORD=

# 그룹웨어 DB (MS SQL Server) — 사내망 접속 시 설정
# sync_gw_users 커맨드에서 Person(employee) + Department 동기화에 사용
GW_ALL_HOST=
GW_ALL_PORT=1433
GW_ALL_USER=
GW_ALL_PASSWORD=
GW_ALL_NAME=
GW_ALL_CHATSET=utf8

# IPScan DB (MariaDB) — 사내망 접속 시 설정
# sync_ipscan 커맨드에서 NetworkDevice 동기화에 사용
IPSCAN_HOST=
IPSCAN_PORT=3306
IPSCAN_USER=
IPSCAN_PASSWORD=
IPSCAN_NAME=
IPSCAN_CHATSET=latin1

# CODING DB (MariaDB, network_db) — 사내망 접속 시 설정
# sync_switch_ports, backup_switch_config 커맨드에서 스위치 정보 조회에 사용
CODING_HOST=
CODING_PORT=3306
CODING_USER=
CODING_PASSWORD=
CODING_NAME=network_db
CODING_CHATSET=utf8mb4

# WinRM (추후 자동 수집용 — 미설정 시 수동 입력만 사용)
ENABLE_WINRM=False
WINRM_USER=
WINRM_PASSWORD=
